# The public site URL is a constant in lib/site.ts (https://sparkv.si); no env var needed.

# Contact form delivery (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_TO_EMAIL=sparkv.inc@gmail.com
# Use a sender on a domain verified in Resend for production.
CONTACT_FROM_EMAIL=SparkV Website <onboarding@resend.dev>

# Careers applications (/api/apply). Uses the Resend settings above.
# Inbox for applications; falls back to CONTACT_TO_EMAIL when empty.
HIRING_TO_EMAIL=
# Optional: POST each application as signed JSON to this URL (best-effort, retried once).
HIRING_WEBHOOK_URL=
# Required when HIRING_WEBHOOK_URL is set. Signature header: X-SparkV-Signature = hex HMAC-SHA256 of the raw body.
HIRING_WEBHOOK_SECRET=
