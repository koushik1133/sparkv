    {
      "parameters": {
        "jsCode": "// Flag: status 'received' older than 3 days, or any open stage idle > 7 days.\nconst now = Date.now(), DAY = 86400000;\nconst closed = ['hired', 'rejected', 'withdrawn'];\nconst t = v => { const n = Date.parse(v); return Number.isNaN(n) ? null : n; };\nconst flagged = [];\nfor (const { json: r } of $input.all()) {\n  const status = String(r.status || '').toLowerCase().trim();\n  if (!r.applicationId || closed.includes(status)) continue;\n  const rec = t(r.receivedAt);\n  const last = t(r.lastUpdate) ?? rec;\n  const reasons = [];\n  if (status === 'received' && rec !== null && now - rec > 3 * DAY) reasons.push('no first response in ' + Math.floor((now - rec) / DAY) + ' days');\n  if (last !== null && now - last > 7 * DAY) reasons.push('idle ' + Math.floor((now - last) / DAY) + ' days in ' + (status || 'unknown'));\n  if (reasons.length) flagged.push({ id: r.applicationId, name: r.name, job: r.jobTitle, status, owner: r.owner || 'unassigned', reasons: reasons.join('; ') });\n}\nconst esc = s => String(s ?? '').replace(/[&<>\"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]));\nconst html = '<p>' + flagged.length + ' application(s) need attention.</p><ul>' +\n  flagged.map(f => '<li><b>' + esc(f.id) + '</b> ' + esc(f.name) + ' - ' + esc(f.job) + ' [' + esc(f.status) + ', owner: ' + esc(f.owner) + ']: ' + esc(f.reasons) + '</li>').join('') + '</ul>';\nreturn [{ json: { count: flagged.length, html } }];"
      },
