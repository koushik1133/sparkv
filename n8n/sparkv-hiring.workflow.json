    {
      "parameters": {
        "jsCode": "// Verify X-SparkV-Signature = hex HMAC-SHA256(raw body, secret). Constant-time compare.\n// Needs env: NODE_FUNCTION_ALLOW_BUILTIN=crypto and HIRING_WEBHOOK_SECRET readable ($env).\nconst crypto = require('crypto');\nconst item = $input.first();\nconst secret = $env.HIRING_WEBHOOK_SECRET;\nif (!secret) throw new Error('HIRING_WEBHOOK_SECRET is not set in the n8n environment');\nconst headers = item.json.headers || {};\nconst sig = String(headers['x-sparkv-signature'] || '').trim().toLowerCase();\nconst raw = await this.helpers.getBinaryDataBuffer(0, 'data'); // Webhook option \"Raw Body\" = on\nconst expected = crypto.createHmac('sha256', secret).update(raw).digest('hex');\nlet valid = false;\nif (/^[0-9a-f]{64}$/.test(sig)) {\n  valid = crypto.timingSafeEqual(Buffer.from(sig, 'hex'), Buffer.from(expected, 'hex'));\n}\nif (!valid) return [{ json: { valid: false } }];\nconst p = JSON.parse(raw.toString('utf8'));\nif (p.event !== 'application.received' || !p.applicationId || !p.email || !p.jobSlug) {\n  return [{ json: { valid: false, reason: 'unexpected payload' } }];\n}\nconst l = p.links || {};\nconst links = ['linkedin', 'portfolio', 'github', 'other'].filter(k => l[k]).map(k => k + ': ' + l[k]).join(' | ');\nreturn [{ json: { valid: true, ...p, linksText: links, emailKey: (p.email + '|' + p.jobSlug).toLowerCase() } }];"
      },
