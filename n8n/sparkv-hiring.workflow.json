    {
      "parameters": {
        "jsCode": "// Compare incoming application against existing sheet rows (email + jobSlug).\nconst incoming = $('Verify Signature').first().json;\nconst rows = $input.all().map(i => i.json);\nconst dup = rows.find(r =>\n  String(r.email || '').toLowerCase() === incoming.email.toLowerCase() &&\n  String(r.jobSlug || '') === incoming.jobSlug &&\n  String(r.applicationId || '') !== incoming.applicationId\n);\n// Also treat the same applicationId as a replay.\nconst replay = rows.some(r => String(r.applicationId || '') === incoming.applicationId);\nreturn [{ json: { ...incoming, duplicate: Boolean(dup) || replay, duplicateOf: dup ? dup.applicationId : (replay ? incoming.applicationId : '') } }];"
      },
